␀␀␀␀␀Ó£ÞJu¥Räš␀␀š␀␀H␀␀␀modules/2f5132d33a0a7c923018e28bee84e31e12e33d5028b1fc3c82877d4e35c2f674module

defineClass BouncyBall morph bounciness yVel groundLevel xVel

method initialize BouncyBall args {
  self_createCostume 60 60 (transparent)
  self_fillCircle 30 30 29 (colorSwatch 79 214 47 255)
  bounciness = 1
}
script 'BouncyBall' 50 50 {
whenKeyPressed '1'
bounciness = 0.6
broadcast 'go'
}

script 'BouncyBall' 434 51 {
whenKeyPressed '3'
bounciness = 0.9
broadcast 'go'
}

script 'BouncyBall' 53 153 {
whenBroadcastReceived 'go'
self_setPosition -300 200
groundLevel = -225
xVel = 1
yVel = 0
self_clear
self_setPenSize 3
self_penDown
animate {
  yVel += -1
  self_moveBy xVel yVel
  if ((self_getY) < groundLevel) {
    self_setY groundLevel
    yVel = (bounciness * (-1 * yVel))
    if ((abs yVel) < 0.5) {
      self_penUp
      self_stopAll
    }
  }
}
}

script 'BouncyBall' 240 51 {
whenKeyPressed '2'
bounciness = 0.75
broadcast 'go'
}

script 'BouncyBall' 305 169 {
method initialize BouncyBall {}
}

