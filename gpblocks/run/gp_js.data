␀␀␀␀␀G«ÞJÍ·ªðÁ␀␀Á␀␀H␀␀␀modules/94eedb8e32da0cbf0a13f14ec7a7a158daba035e0be42d216115128bdcd832b4module

defineClass Wheel morph n speed

method initialize Wheel args {
  self_createCostume 500 500
  self_fillWithColor (transparent)
  self_fillCircle 250 250 249 (transparent) 25 (colorSwatch 8 8 8 255)
  self_drawLine 0 250 500 250 (colorSwatch 55 55 55 255) 25
  self_drawLine 250 0 250 500 (colorSwatch 55 55 55 255) 25
  speed = 1.0
}

defineClass Car morph n

method initialize Car args {
  self_createCostume 150 150
  self_fillWithColor (transparent)
  self_fillRect 0 100 150 50 (colorSwatch 191 14 41 255)
  self_fillRect 65 0 20 100 (colorSwatch 49 254 211 255)
  self_setPinXY 0 -75
}

defineClass Base morph n

method initialize Base args {
  self_createCostume 500 500
  self_fillWithColor (transparent)
  for i 500 {
    self_fillRect (250 - (i / 2.0)) i i 1 (colorSwatch 190 190 190 255)
  }
}
script 'Wheel' 50 50 {
whenBroadcastReceived 'go'
animate {
  self_changeRotation speed
}
}

script 'Wheel' 298 213 {
whenKeyPressed 'space'
speed = 1.0
}

script 'Wheel' 297 133 {
whenKeyPressed 'left arrow'
speed += -1
}

script 'Wheel' 52 182 {
method initialize Wheel {}
}

script 'Wheel' 295 56 {
whenKeyPressed 'right arrow'
speed += 1
}

script 'Car' 50 50 {
method initialize Car {}
}

script 'Base' 50 67 {
whenKeyPressed 'space'
self_setScale 1
}

script 'Base' 53 154 {
method initialize Base {}
}

script 'Base' 302 64 {
whenKeyPressed 'up arrow'
self_changeScale 0.1
}

script 'Base' 304 152 {
whenKeyPressed 'down arrow'
self_changeScale -0.1
}

