␀␀␀␀␀v ÞJ_Óu	z␀␀z␀␀H␀␀␀modules/47deb0dbb72ca7bf8a2c8eca1e4c21a262d75a7e70e3953704b8c7647bbc68cemodule

defineClass MyList morph n itemY itemX sortFunc names


defineClass Person morph name lists

method Person_name Person {
  return name
}

method Person_set Person x y {
  self_setPosition x y
}

method Person_top Person {
  return (self_getY)
}

method init Person s {
  name = s
  self_createCostume 250 40 (colorSwatch 223 223 223 255)
  self_setFont 'Helvetica' 36
  self_drawText name 10 3 (colorSwatch 7 7 7 255)
}
script 'MyList' 255 50 {
broadcast 'clear list'
}

script 'MyList' 424 52 {
for name (words 'John Jens Yoshiki Jen Mark Sam Alan') {
  init (self_instantiate 'Person') name
}
}

script 'MyList' 50 59 {
whenBroadcastReceived 'list changed'
itemX = (self_getX)
itemY = ((self_getY) + 165)
sortFunc = (function m1 m2 {
  return ((Person_top m2) < (Person_top m1))
}
)
names = (list)
for entry (sorted (self_parts) sortFunc) {
  add names (Person_name entry)
  Person_set entry itemX itemY
  itemY += -45
}
}

script 'MyList' 454 285 {
whenBroadcastReceived 'initialize'
self_createCostume 280 400
}

script 'MyList' 588 132 {
whenBroadcastReceived 'clear list'
for item (self_parts) {
  self_delete item
}
}

script 'Person' 53 434 {
method Person_name Person {}
}

script 'Person' 52 340 {
method Person_top Person {}
}

script 'Person' 52 164 {
method init Person {}
}

script 'Person' 50 57 {
whenClicked
self_grab
broadcast 'list changed'
}

script 'Person' 299 324 {
method Person_set Person {}
}

script 'Person' 299 50 {
whenDropped
lists = (self_neighbors 0 'MyList')
if ((count lists) > 0) {
  self_addPart this (first lists)
  broadcastAndWait 'list changed'
  self_setDraggable true
} else {
  self_setDraggable true
}
}

