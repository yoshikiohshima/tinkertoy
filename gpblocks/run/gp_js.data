␀␀␀␀␀£ŒcJþÂ4Á¨␀␀¨␀␀H␀␀␀modules/b4f2225a01e835273ebb76f4f824784282487ab8579a7eec603fc92d5596ccdamodule

defineClass MirrorBrush morph n


defineClass Brush morph n

script 'MirrorBrush' 39 31 {
whenBroadcastReceived 'go'
self_hide
animate {
  self_setPenSize 10
  self_setPenColor (colorSwatch 38 41 191 255)
  if (handIsDown) {
    self_penDown
  } else {
    self_penUp
  }
  self_setPosition (0 - (self_mouseX)) (self_mouseY)
}
}

script 'Brush' 273 58 {
whenKeyPressed 'space'
self_clear
}

script 'Brush' 50 50 {
whenBroadcastReceived 'go'
self_setDraggable false
self_hide
animate {
  self_setPenSize 10
  self_setPenColor (colorSwatch 38 41 191 255)
  if (handIsDown) {
    self_penDown
  } else {
    self_penUp
  }
  self_setPosition (self_mouseX) (self_mouseY)
}
}

