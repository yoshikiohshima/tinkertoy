␀␀␀␀␀}¬áJ¿uŸœ␀␀œ␀␀H␀␀␀modules/59eb97091d786a84502baec2b43eeba6999997789782be277d5800f5d9feee05module
moduleVariables dust 'vacuum hose opening'

defineClass Dust morph radius

method initialize Dust args {
  setMy 'radius' 50
  self_createCostume 100 100 (transparent)
  self_fillCircle (my 'radius') (my 'radius') (my 'radius') (colorSwatch 20 38 175 255)
  setShared 'dust' this
}

method m_53392478714695 Dust {
  local 'totalX' 0
  local 'totalY' 0
  for p (self_neighbors 20 'Particle') {
    if ((self_distanceToSprite p) < ((my 'radius') + 20)) {
      local 'dir' ((self_directionToSprite p) + 180)
      totalX += (cos dir)
      totalY += (sin dir)
      m_533953746935820 p (dir + 180)
    }
    self_moveBy (0.4 * totalX) (0.4 * totalY)
  }
}

defineClass Main morph

method m_533925565112367 Main {
  for p (self_neighbors 10000 'Particle') {
    m_533924326627529 p
  }
  m_53392478714695 (shared 'dust')
}

defineClass Hose morph


defineClass Particle morph

method initialize Particle args {
  self_createCostume 20 20 (transparent)
  self_fillCircle 10 10 10 (colorSwatch 35 190 30 255)
  self_setRotation (rand 360)
}

method m_533924326627529 Particle {
  self_moveInDirection 8
  if (self_touching (shared 'vacuum hose opening')) {
    self_setX -400
  }
  self_bounceOffEdge
}

method m_533953746935820 Particle dir {
  self_setRotation dir
}
script 'Dust' 51 61 {
method m_53392478714695 Dust {}
}

script 'Dust' 318 50 {
whenBroadcastReceived 'reset dust'
self_setPosition -100 0
}

script 'Dust' 50 488 {
method initialize Dust {}
}

script 'Main' 50 282 {
method m_533925565112367 Main {}
}

script 'Main' 303 50 {
whenKeyPressed 'space'
self_stopAll
broadcast 'clear'
broadcastAndWait 'reset dust'
}

script 'Main' 50 50 {
whenBroadcastReceived 'go'
broadcastAndWait 'clear'
repeat 400 {
  self_instantiate 'Particle'
}
broadcastAndWait 'reset dust'
animate {
  m_533925565112367 this
}
}

script 'Hose' 50 51 {
self_createCostume 10 200 (colorSwatch 12 12 12 255)
setShared 'vacuum hose opening' this
}

script 'Particle' 50 250 {
method m_533924326627529 Particle {}
}

script 'Particle' 51 59 {
method initialize Particle {}
}

script 'Particle' 302 50 {
whenBroadcastReceived 'clear'
self_delete
}

script 'Particle' 327 216 {
method m_533953746935820 Particle {}
}

