␀␀␀␀␀o¶nKØDˆ␀␀␀␀H␀␀␀modules/dba755a91bcedba9a4731258861e691f917d37be69b52f57d6016c57a15e44e9module

defineClass MyClass morph n player

script 'MyClass' 54 50 {
whenBroadcastReceived 'go'
player = (playerForMIDIFile 'BachPrelude')
playScore player
}

script 'MyClass' 51 152 {
whenKeyPressed 'a'
setTrackMuted player 1 false
setTrackMuted player 2 false
setTrackMuted player 3 false
}

script 'MyClass' 50 275 {
whenKeyPressed '1'
setTrackMuted player 1 false
setTrackMuted player 2 true
setTrackMuted player 3 true
}

script 'MyClass' 50 401 {
whenKeyPressed '3'
setTrackMuted player 1 true
setTrackMuted player 2 true
setTrackMuted player 3 false
}

script 'MyClass' 409 60 {
whenKeyPressed 'g'
setInstrumentForTrack player 1 'guitar'
setInstrumentForTrack player 2 'guitar'
setInstrumentForTrack player 3 'guitar'
}

script 'MyClass' 406 202 {
whenKeyPressed 'o'
setInstrumentForTrack player 1 'organ'
setInstrumentForTrack player 2 'organ'
setInstrumentForTrack player 3 'organ'
}

script 'MyClass' 406 347 {
whenKeyPressed '2'
setTrackMuted player 1 true
setTrackMuted player 2 false
setTrackMuted player 3 true
}

