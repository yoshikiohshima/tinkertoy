␀␀␀␀␀Ë³nKbàéì7␀␀7␀␀H␀␀␀modules/b3ab433ad603c7611b59a68c42b38c71570be49b064ec190447a07f1df32ccf5module

defineClass Setup morph


defineClass Letter morph letter direction previous next original copy

method initialize Letter ch {
  if (isNil ch) {ch = 'a'}
  setMy 'letter' ch
  setMy 'direction' (rand 360)
  setMy 'previous' nil
  setMy 'next' nil
  setMy 'original' nil
  setMy 'copy' nil
  self_createCostume 24 24 (transparent)
  local 'color' (colorHSV (25 * (byteAt (my 'letter') 1)) 0.15 0.9)
  self_fillCircle 12 12 12 color
  self_setFont 'Arial Bold' 16
  self_drawText (my 'letter') (12 - ((stringWidth (my 'letter')) / 2)) 2 (colorSwatch 3 3 3 255)
}

method m_539539746425152 Letter {
  local 'speed' 3
  if (isNil (my 'next')) {
    speed = 12
  }
  self_moveBy (speed * (cos (my 'direction'))) (speed * (sin (my 'direction')))
  increaseMy 'direction' (rand -35 35)
  self_keepInOwner
}

method m_539540825784680 Letter aLetter {
  self_setRotation (self_directionToSprite aLetter)
  self_moveInDirection ((self_distanceToSprite aLetter) - 20)
  self_setRotation 0
}

method m_539540977754392 Letter {
  if (notNil (my 'previous')) {
    m_539540825784680 this (my 'previous')
    m_539718728147920 this
  } (notNil (my 'original')) {
    m_539541597551123 this (my 'original')
    m_539718728147920 this
  } else {
    m_539539746425152 this
  }
}

method m_539541169506211 Letter aLetter {
  setMy 'previous' aLetter
}

method m_539541175162116 Letter aLetter {
  setMy 'original' aLetter
}

method m_539541597551123 Letter aLetter {
  self_setRotation (self_directionToSprite aLetter)
  self_moveInDirection (self_distanceToSprite aLetter)
  self_moveBy 0 -23
  self_setRotation 0
}

method m_539542044401310 Letter ch {
  return (and (isNil (my 'previous')) (isNil (my 'next')) (isNil (my 'original')) (isNil (my 'copy')) (ch == (my 'letter')))
}

method m_539542288441195 Letter {
