␀␀␀␀␀SKH}/½w␀␀w␀␀H␀␀␀modules/2506aa9c252564ce4ed8d157c69e839d83967d7e20865715b33e2cfadb4b852emodule

to initializeModule {
  comment 'Experimental -- add an instance to stage when the module is loaded.'
  stage = (first (allInstances 'Stage'))
  if (notNil stage) {
    instantiate (class 'Circle') (morph stage)
  }
}

to newCircle r c {
  local 'newCircle' (self_instantiate 'Circle')
  if (notNil r) {
    broadcast 'set radius' r newCircle
  }
  if (notNil c) {
    broadcast 'set color' c newCircle
  }
}

defineClass Circle morph width height color radius

method draw Circle {
  local 'diameter' (2 * (my 'radius'))
  self_createCostume diameter diameter (transparent)
  self_fillCircle (my 'radius') (my 'radius') (my 'radius') (my 'color')
}

method initialize Circle data {
  setMy 'radius' 50
  setMy 'color' (randomColor)
  draw this
}
script 'Circle' 423 378 {
to initializeModule {}
}

script 'Circle' 50 183 {
method initialize Circle {}
}

script 'Circle' 51 365 {
to newCircle {}
}

script 'Circle' 316 177 {
method draw Circle {}
}

script 'Circle' 313 50 {
whenBroadcastReceived 'set color' 'c'
setMy 'color' c
draw this
}

script 'Circle' 50 54 {
whenBroadcastReceived 'set radius' 'r'
setMy 'radius' r
draw this
}

