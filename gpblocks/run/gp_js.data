␀␀␀␀␀ðfsKæ™iB]␀␀]␀␀H␀␀␀modules/f1be4824a41d6ed5cd54f289f0a1f9c42d6cfc7069c07600ec0147c02d5500f1module

defineClass Pen morph

script 'Pen' 50 50 {
whenBroadcastReceived 'go'
self_createCostume 5 5 (colorSwatch 7 7 7 255)
self_clear
self_setPenColor (colorSwatch 35 190 30 255)
self_penDown
for angle (range 0 360 36) {
  self_setRotation angle
  repeat 4 {
    self_moveInDirection 100
    self_changeRotation 90
  }
  waitSecs
}
self_penUp
}

