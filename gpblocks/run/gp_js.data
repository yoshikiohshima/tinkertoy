␀␀␀␀␀FŒnKP(ôœ␀␀œ␀␀H␀␀␀modules/7973c84aedae8dc4de64ef27a27cc422b5dddd7948a3d0e51e56128856cc83admodule

defineClass MySlider morph n length value minValue range changeMsg

method drawSlider MySlider {
  self_fillWithColor (transparent)
  self_fillRect 0 2 length 16 (colorSwatch 194 194 194 255)
  local 'fraction' ((value - minValue) / range)
  self_fillRect (fraction * (length - 8)) 0 8 20 (colorSwatch 54 54 54 255)
}

method initialize MySlider {
  setMy 'length' 500
  setMy 'value' 30
  setMy 'minValue' 0
  setMy 'range' 100
  setMy 'changeMsg' 'slider changed'
  self_createCostume length 20
  drawSlider this
}
script 'MySlider' 53 58 {
method initialize MySlider {}
}

script 'MySlider' 321 50 {
whenTracking 'mouse x' 'mouse y'
local 'fraction' (clamp ((self_localMouseX) / (my 'length')) 0 1)
setMy 'value' ((my 'minValue') + (fraction * (my 'range')))
setMy 'value' (round (my 'value'))
drawSlider this
broadcast (my 'changeMsg') (my 'value')
}

script 'MySlider' 54 297 {
method drawSlider MySlider {}
}

