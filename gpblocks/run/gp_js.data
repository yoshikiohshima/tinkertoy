␀␀␀␀␀ÕîJ:¯D’Ó␀␀Ó␀␀H␀␀␀modules/bd22df7a5a93f5f2c6f1608cfa737045b5dbc5771dae4a4e5ab41ff715b401aamodule

defineClass 'Arrow Maker' morph n


defineClass Arrow morph

method initialize Arrow {
  self_createCostume 100 100 (transparent)
  self_drawLine 0 50 100 50 (colorSwatch 191 18 62 255) 4
  self_drawLine 100 50 75 25 (colorSwatch 191 18 62 255) 4
  self_drawLine 100 50 75 75 (colorSwatch 191 18 62 255) 4
  self_setScale 0.6
}
script 'Arrow Maker' 50 50 {
whenBroadcastReceived 'go'
self_hide
broadcast 'clear'
repeat 100 {
  self_instantiate 'Arrow'
}
broadcast 'activate'
}

script 'Arrow' 55 56 {
whenBroadcastReceived 'activate'
animate {
  self_setRotation (self_directionToMouse)
}
}

script 'Arrow' 54 186 {
method initialize Arrow {}
}

script 'Arrow' 348 52 {
whenBroadcastReceived 'clear'
self_delete
}

