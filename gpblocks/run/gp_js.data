␀␀␀␀␀¶nKaÇ°&7␀␀7␀␀H␀␀␀modules/452b835be04fd189d2fda071337dd565e87007e000eba71d5e5474075ee14640module

to f_541695227794528 title {
  local 'result' (self_instantiate 'ListViewer' title)
  setTitle result title
  m_541695016218866 result (shuffled (range 1 50))
  return result
}

to f_541697772189334 list i j viewer {
  local 'tmp' (at list i)
  atPut list i (at list j)
  atPut list j tmp
  m_541695016218866 viewer list
  waitSecs
}

to f_541698193784472 list lo hi viewer {
  local 'pivot' (at list hi)
  local 'i' (lo - 1)
  for j (range lo (hi - 1)) {
    if ((at list j) <= pivot) {
      i += 1
      f_541697772189334 list i j viewer
    }
  }
  f_541697772189334 list (i + 1) hi viewer
  return (i + 1)
}

defineClass Sorting morph 'viewer 1' 'viewer 2' 'viewer 3' N

method m_541698976652559 Sorting list lo hi {
  if (lo < hi) {
    local 'p' (f_541698193784472 list lo hi (my 'viewer 3'))
    m_541698976652559 this list lo (p - 1)
    m_541698976652559 this list (p + 1) hi
  }
}

defineClass ListViewer morph title

method m_541686012639923 ListViewer {
  self_setFont 'Arial Bold' 16
  local 'x' (((self_getWidth) - (stringWidth (my 'title'))) / 2)
  self_drawText (my 'title') x 3 (colorSwatch 0 0 0 255)
}

method m_541695016218866 ListViewer list {
  self_createCostume 720 150
  m_541686012639923 this
  local 'max' 0
  for el list {
    if (el > max) {max = el}
  }
  if (and (max > 0) ((count list) > 0)) {
    local 'scale' (((self_getHeight) - 35) / max)
    local 'barW' (((self_getWidth) - 20) / (count list))
    local 'bottom' ((self_getHeight) - 10)
    local 'x' 10
    for el list {
      if (el > 0) {
        local 'w' (max 1 (barW - 1))
        local 'h' (round (el * scale))
        self_fillRect x (bottom - h) w h (colorSwatch 35 190 30 255)
        x += barW
      }
    }
  }
}

method setTitle ListViewer s {
  setMy 'title' s
}
script 'Sorting' 423 87 {
whenBroadcastReceived 'go'
broadcast 'bubble sort'
broadcast 'insertion sort'
broadcast 'quick sort'
}

