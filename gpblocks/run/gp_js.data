␀␀␀␀␀•nK;¬9¹ú␀␀ú␀␀H␀␀␀modules/20a1a1498efe1865ed7648ccb1d06387001c882595227a9b770db0858e98a6bemodule

defineClass Controller morph n


defineClass Bubble morph n isEmplar

method initialize Bubble {
  self_createCostume 100 100 (transparent)
  self_fillCircle 50 50 45 (randomColor)
  self_fillCircle 45 45 30 (colorSwatch 0 0 0 255)
  self_floodFill 45 45 (transparent)
  self_setScale (rand 0.1 0.4)
  self_setY (0 - ((stageHeight) / 2))
}
script 'Controller' 272 59 {
whenKeyPressed 'space'
broadcast 'clear'
}

script 'Controller' 50 50 {
whenBroadcastReceived 'go'
self_hide
broadcast 'bubble'
animate {
  send 'bubble' (self_instantiate 'Bubble')
}
}

script 'Bubble' 51 295 {
method initialize Bubble {}
}

script 'Bubble' 430 50 {
whenBroadcastReceived 'bubble'
animate {
  if ((self_distanceToMouse) < 50) {self_delete}
}
}

script 'Bubble' 50 53 {
whenBroadcastReceived 'bubble'
local 'speed' (rand 12)
while ((self_getY) < ((stageHeight) / 2)) {
  self_moveBy (rand -5 5) speed
  waitSecs
}
waitSecs (rand 0.1 0.3)
self_delete
}

script 'Bubble' 433 243 {
whenBroadcastReceived 'clear'
self_delete
}

