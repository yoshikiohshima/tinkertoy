␀␀␀␀␀.³îJ0ì Ü␀␀Ü␀␀H␀␀␀modules/9588c61f9ceaee63853bb7a3821fb1fd772388a956a3f369973c9a987dc4134amodule

defineClass Clock morph n hour endX endY handWidth handLength minute second

method drawHand Clock angle w length {
  self_setPenSize w
  self_setPenColor (colorSwatch 2 2 2 255)
  self_setPosition 0 0
  self_setRotation angle
  self_penDown
  self_moveInDirection length
  self_penUp
}

method m_552173290728966 Clock {
  self_clear
  m_552173783625788 this
  hour = (at (localDateAndTime) 4)
  minute = (at (localDateAndTime) 5)
  second = (at (localDateAndTime) 6)
  drawHand this ((3 - hour) * (360 / 12)) 15 130
  drawHand this ((15 - minute) * (360 / 60)) 9 180
  drawHand this ((15 - second) * (360 / 60)) 5 190
}

method m_552173783625788 Clock {
  self_setPosition 0 230
  self_setRotation 0
  self_setPenColor (colorSwatch 11 11 11 255)
  self_setPenSize 8
  self_penDown
  repeat 36 {
    self_moveInDirection 40
    self_changeRotation 10
  }
  self_penUp
  self_penFillArea 0 0 (colorSwatch 246 251 212 255)
}
script 'Clock' 103 70 {
whenBroadcastReceived 'go'
self_createCostume 5 5
self_hide
animate {
  m_552173290728966 this
  waitSecs 1
}
}

script 'Clock' 106 262 {
method m_552173783625788 Clock {}
}

script 'Clock' 424 50 {
method m_552173290728966 Clock {}
}

script 'Clock' 427 460 {
method drawHand Clock {}
}

