␀␀␀␀␀ZZWKx™Ê␀␀␀␀H␀␀␀modules/472fa930fcd9245c8e7299ecaced7a46739f97e16cbac950d55a30d1a4720e1bmodule

to newLabel s {
  local 'result' (self_instantiate 'Label')
  setLabelFont result 'Verdana Bold' 24
  setLabelContents result s
  return result
}

defineClass Label morph contents fontName fontSize color

method drawLabel Label {
  self_setFont (my 'fontName') (my 'fontSize')
  local 'lines' (lines (my 'contents'))
  local 'w' 0
  for s lines {
    w = (max w (stringWidth s))
  }
  self_createCostume (w + 8) (((count lines) * (fontHeight)) + 6) (transparent)
  local 'y' 2
  for s lines {
    print s
    local 'indent' (((self_getWidth) - (stringWidth s)) / 2)
    self_drawText s indent y (my 'color')
    y += (fontHeight)
  }
}

method initialize Label data {
  setTransparentTouch morph true
  setMy 'contents' 'A Label'
  setMy 'fontName' 'Verdana Bold'
  setMy 'fontSize' 24
  setMy 'color' (gray 30)
  drawLabel this
}

method setLabelContents Label s {
  setMy 'contents' s
  drawLabel this
}

method setLabelFont Label name size c {
  setMy 'fontName' name
  setMy 'fontSize' size
  setMy 'color' c
  drawLabel this
}
script 'Label' 52 50 {
to newLabel {}
}

script 'Label' 444 52 {
method drawLabel Label {}
}

script 'Label' 53 379 {
method setLabelFont Label {}
}

script 'Label' 50 242 {
method setLabelContents Label {}
}

script 'Label' 52 593 {
method initialize Label {}
}

