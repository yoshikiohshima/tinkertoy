method m_541698976652559 Sorting {}
}

script 'Sorting' 960 247 {
whenBroadcastReceived 'quick sort'
local 'list' (shuffled (range 1 (my 'N')))
m_541698976652559 this list 1 (count list)
}

script 'Sorting' 54 271 {
whenBroadcastReceived 'bubble sort'
local 'list' (shuffled (range 1 (my 'N')))
local 'swapped' (booleanConstant true)
while swapped {
  swapped = (booleanConstant false)
  for i ((count list) - 1) {
    if ((at list i) > (at list (i + 1))) {
      f_541697772189334 list i (i + 1) (my 'viewer 1')
      swapped = (booleanConstant true)
    }
  }
}
}

script 'Sorting' 460 279 {
whenBroadcastReceived 'insertion sort'
local 'list' (shuffled (range 1 (my 'N')))
for i (range 2 (count list)) {
  local 'j' i
  while (and (j > 1) ((at list (j - 1)) > (at list j))) {
    f_541697772189334 list (j - 1) j (my 'viewer 2')
    j += -1
  }
}
}

