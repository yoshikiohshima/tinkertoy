␀␀␀␀␀é¶ÞJ†xÝ?f␀␀f␀␀H␀␀␀modules/fed50efe2dcb2cf6ec0393663a49d4981aa6bfd9713ba13084262a650b4e6697module

defineClass MyClass morph n

method initialize MyClass {
  self_createCostume 40 40
  self_fillWithColor (colorSwatch 7 7 7 255)
  self_fillRect 2 2 36 36 (colorSwatch 249 249 249 255)
  self_floodFill 20 20 (transparent)
}
script 'MyClass' 50 50 {
whenBroadcastReceived 'go'
local 'tiltRange' 0
self_clear
self_show
self_clear
self_setPosition -225 -225
for i 12 {
  for k 10 {
    self_setRotation (rand (0 - tiltRange) tiltRange)
    self_stampCostume
    self_moveBy 40 0
  }
  self_moveBy -400 40
  tiltRange += 4
}
self_setPosition -500 0
}

script 'MyClass' 306 53 {
method initialize MyClass {}
}

