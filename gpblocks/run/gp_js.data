␀␀␀␀␀˜¨Kù§‚Èy␀␀y␀␀H␀␀␀modules/09ad1e82490541727d8442dd1a7577ffe37d44b42bb3456795f7f3aa26a78efdmodule

defineClass Circle morph hue brightness saturation color

script 'Circle' 50 50 {
whenBroadcastReceived 'go'
self_createCostume 200 200 (transparent)
animate {
  setMy 'saturation' 0.8
  setMy 'hue' (self_directionToMouse)
  setMy 'brightness' ((self_distanceToMouse) / 250)
  setMy 'color' (colorHSV hue saturation brightness)
  self_fillCircle 100 100 100 color
}
}

