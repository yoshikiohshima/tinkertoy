␀␀␀␀␀oSKmƒ1”š␀␀š␀␀H␀␀␀modules/b2899d955c385b5f0837542434fe22e756a4d83f5559ce7dc8029818ad10caa0module

to newGauge c {
  local 'result' (self_instantiate 'Gauge')
  if (notNil c) {
    setGaugeColor result c
  }
  return result
}

defineClass Gauge morph color level

method drawGauge Gauge {
  local 'border' 2
  self_fillWithColor (colorSwatch 35 35 35 255)
  local 'w' ((self_getWidth) - (2 * border))
  local 'h' (((my 'level') / 100) * ((self_getHeight) - border))
  self_fillRect border 0 w ((self_getHeight) - border) (transparent)
  self_fillRect border ((self_getHeight) - (+ border h -1)) w h (my 'color')
}

method initialize Gauge data {
  setMy 'color' (randomColor)
  setMy 'level' 30
  setDimensions this 15 100
}

method setDimensions Gauge w h {
  self_createCostume (max w 8) h
  drawGauge this
}

method setGaugeColor Gauge c {
  setMy 'color' c
  drawGauge this
}

method setGaugeLevel Gauge n {
  setMy 'level' n
  drawGauge this
}
script 'Gauge' 50 97 {
method setGaugeLevel Gauge {}
}

script 'Gauge' 50 235 {
method setDimensions Gauge {}
}

script 'Gauge' 53 382 {
method setGaugeColor Gauge {}
}

script 'Gauge' 54 519 {
method initialize Gauge {}
}

script 'Gauge' 427 327 {
method drawGauge Gauge {}
}

script 'Gauge' 424 89 {
to newGauge {}
}

