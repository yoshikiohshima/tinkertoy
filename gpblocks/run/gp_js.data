␀␀␀␀␀ÉµnKè
@U␀␀U␀␀H␀␀␀modules/10e79f6a2231a387c43fc1a148e6c58419e6dcd33a2e6b2d33812ab51ac8d0c0module

defineClass MyClass morph n

method initialize MyClass {
  self_createCostume 10 10
  self_fillWithColor (transparent)
  self_fillCircle 5 5 5 (colorSwatch 11 5 191 255)
}

method sierpinski MyClass level size {
  if (level > 0) {repeat 3 {
    sierpinski this (level - 1) (size / 2)
    self_moveInDirection size n
    n += 120
  }
}
}
script 'MyClass' 50 50 {
whenBroadcastReceived 'go'
n = 0
self_clear
self_setPenSize 2
self_penDown
sierpinski this 7 500
self_penUp
}

script 'MyClass' 276 53 {
method initialize MyClass {}
}

script 'MyClass' 53 248 {
method sierpinski MyClass {}
}

