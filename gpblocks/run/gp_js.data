␀␀␀␀␀‹nK§%˜Â␀␀Â␀␀H␀␀␀modules/e785b6115719e5fe5ab9a2d4478799c33d9ce7607e335770f9cdcdd30e823822module

defineClass ChainLink morph n step

method initialize ChainLink {
  self_createCostume 160 20
  self_fillWithColor (transparent)
  self_fillRect 0 5 150 10 (colorSwatch 20 20 20 255)
  self_setPinXY 70 0
  self_fillCircle 150 10 9 (colorSwatch 191 9 37 255)
}

defineClass pencil morph n

method initialize pencil {
  self_createCostume 20 20
  self_fillWithColor (transparent)
  self_fillCircle 10 10 10 (colorSwatch 38 39 191 255)
}
script 'ChainLink' 50 59 {
whenBroadcastReceived 'go'
step = (rand -5.0 5.0)
animate {
  self_changeRotation step
}
}

script 'ChainLink' 51 209 {
method initialize ChainLink {}
}

script 'pencil' 73 52 {
whenBroadcastReceived 'reset'
waitSecs (rand 20 60)
self_stopAll
broadcast 'go'
}

script 'pencil' 59 256 {
method initialize pencil {}
}

script 'pencil' 270 151 {
whenBroadcastReceived 'go'
broadcast 'reset'
self_clear
self_setPenColor (randomColor)
self_setPenSize ((rand 5) * (global 'scale'))
self_penDown
}

