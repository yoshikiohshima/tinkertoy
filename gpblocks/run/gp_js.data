␀␀␀␀␀ë¹áJæMÇ¢(␀␀(␀␀H␀␀␀modules/16f4c45887237a508c8b540b45957053259db377964aec7c6ab77f8b179d5831module

to f_552183481978798 text key {
  return (f_552183537466729 text (0 - key))
}

to f_552183537466729 text key {
  local 'result codes' (list)
  for code (codePoints (toLowerCase text)) {
    code = (code - 97)
    if (isBetween code 0 25) {
      code = ((+ code key 26) % 26)
    }
    add (v 'result codes') (code + 97)
  }
  return (stringFromCodePoints (v 'result codes'))
}

defineClass Encoder morph encoded

script 'Encoder' 51 261 {
whenKeyPressed 'down arrow'
self_say 'I will now decode the last message.'
waitSecs 2
self_sayNothing
local 'key' (round (askUser 'Enter your secret key (a number)'))
self_say (join 'Message: ' (f_552183481978798 (my 'encoded') key))
}

script 'Encoder' 523 424 {
to f_552183481978798 {}
}

script 'Encoder' 521 50 {
to f_552183537466729 {}
}

script 'Encoder' 50 55 {
whenKeyPressed 'up arrow'
local 'message' (askUser 'Please enter your message')
local 'key' (round (askUser 'Enter your secret key (a number)'))
setMy 'encoded' (f_552183537466729 message key)
self_say (join 'Encoded message: ' (my 'encoded'))
}

