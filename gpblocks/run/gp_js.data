␀␀␀␀␀:¹nKu¯tad␀␀d␀␀H␀␀␀modules/c4f798b9b70615187577b0fc25e06e36e895172df26aee9a2e50282deeed0832module
moduleVariables score 'track color'

defineClass MuteButton morph track

method m_550858787929065 MuteButton {
  self_fillWithColor (transparent)
  self_fillRect 0 0 18 18 (colorSwatch 1 1 1 255) 3
  if (isTrackMuted (shared 'score') (my 'track')) {
    self_fillRect 2 2 14 14 (colorSwatch 212 212 212 255) 3
  } else {
    self_fillRect 2 2 14 14 (at (shared 'track color') (my 'track')) 3
  }
}

defineClass Title morph n 'midi file'

method m_55085912962178 Title title {
  self_setFont 'Arial' 36
  self_createCostume ((stringWidth title) + 10) ((fontHeight) + 5) (colorSwatch 240 240 240 255)
  self_drawText title 0 0 (colorSwatch 12 12 12 255)
  self_setPosition 0 215
}

defineClass Instrument morph track

method m_550858643709362 Instrument {
  if (isNil (my 'track')) {return ''}
  local 'instrument name' (instrumentForTrack (shared 'score') (my 'track'))
  self_setFont 'Arial' 22
  self_createCostume (stringWidth (v 'instrument name')) ((fontHeight) + 3) (gray 255 1)
  self_setFont 'Arial' 22
  self_drawText (v 'instrument name') 0 0 (colorSwatch 12 12 12 255)
  self_setPosition (-355 + ((self_getWidth) / 2)) (170 - (30 * (my 'track')))
}

defineClass PianoRoll morph n xScale 'first visible note'

method m_550170225827469 PianoRoll {
  self_fillWithColor (colorSwatch 233 233 233 255)
  local 'startTime' ((scoreTime (shared 'score')) - (265 * xScale))
  local 'endTime' (startTime + 500)
  for track (trackCount (shared 'score')) {
    local 'c' (at (shared 'track color') track)
    m_550171111643680 this track startTime c
  }
  self_fillRect 265 0 1 450 (colorSwatch 192 192 192 255)
}

method m_550171111643680 PianoRoll track start color {
  if (not (isTrackMuted (shared 'score') track)) {
    local 'yOffset' ((25 * track) + 75)
    local 'notes' (notesForTrack (shared 'score') track)
    local 'note count' (count notes)
    m_550868434732449 this track start
    local 'i' (at (my 'first visible note') track)
    while (i <= (v 'note count')) {
      local 'n' (at notes i)
      local 'x' (((startTime n) - start) / xScale)
      if (x > (self_getWidth)) {
        return ''
      }
      local 'w' ((duration n) / xScale)
      local 'y' (yOffset - (key n))
      self_fillRect (x + 0) y w 2 color
      i += 1
    }
  }
}

method m_550868133176242 PianoRoll {
  setMy 'first visible note' (list)
  for track (trackCount (shared 'score')) {
    add (my 'first visible note') 1
  }
}

method m_550868434732449 PianoRoll track startTime {
  local 'notes' (notesForTrack (shared 'score') track)
  local 'note count' (count notes)
  local 'i' (at (my 'first visible note') track)
  while (i <= (v 'note count')) {
    local 'n' (at notes i)
    if (((startTime n) + (duration n)) > startTime) {
      atPut (my 'first visible note') track i
      return ''
    }
    i += 1
  }
}
script 'MuteButton' 454 244 {
method m_550858787929065 MuteButton {}
}

script 'MuteButton' 454 50 {
whenClicked
local 'muted' (not (isTrackMuted (shared 'score') (my 'track')))
setTrackMuted (shared 'score') (my 'track') muted
m_550858787929065 this
}

script 'MuteButton' 51 57 {
whenBroadcastReceived 'clear tracks'
self_delete
}

script 'MuteButton' 51 141 {
whenBroadcastReceived 'set track number' 'track number'
setMy 'track' (v 'track number')
self_createCostume 18 18
self_setDraggable false
self_setPosition -375 (170 - (30 * (v 'track number')))
m_550858787929065 this
}

script 'Title' 440 50 {
whenClicked
self_setDraggable false
stopAllSounds
local 'fileName' (selectFromMenu (listFiles (runtimeFolder 'midi/')))
if (isNil fileName) {
  setShared 'score' (newScorePlayer)
  m_55085912962178 this 'Click to choose music'
} else {
  setShared 'score' (playerForMIDIFile fileName)
  m_55085912962178 this (withoutExtension fileName)
}
broadcastAndWait 'init piano roll'
broadcastAndWait 'clear tracks'
for i (trackCount (shared 'score')) {
  send 'set track number' (self_instantiate 'Instrument') i
  send 'set track number' (self_instantiate 'MuteButton') i
}
}

script 'Title' 52 299 {
method m_55085912962178 Title {}
}

script 'Title' 50 214 {
whenKeyPressed 'space'
broadcast 'go'
}

script 'Title' 50 60 {
whenBroadcastReceived 'go'
self_stopAll
stopAllSounds
broadcast 'start piano roll'
playScore (shared 'score')
}

script 'Instrument' 557 50 {
method m_550858643709362 Instrument {}
}

script 'Instrument' 53 139 {
whenClicked
local 'result' (selectFromMenu (instrumentNames))
if (notNil result) {
  setInstrumentForTrack (shared 'score') (my 'track') result
  m_550858643709362 this
}
}

script 'Instrument' 52 58 {
whenBroadcastReceived 'clear tracks'
self_delete
}

script 'Instrument' 57 350 {
whenBroadcastReceived 'set track number' 'track number'
setMy 'track' (v 'track number')
self_setDraggable false
m_550858643709362 this
}

script 'PianoRoll' 55 742 {
method m_550868434732449 PianoRoll {}
}

script 'PianoRoll' 617 70 {
whenKeyPressed 'up arrow'
setMy 'xScale' ((my 'xScale') / 1.5)
m_550170225827469 this
}

script 'PianoRoll' 623 1013 {
method m_550868133176242 PianoRoll {}
}

script 'PianoRoll' 50 70 {
whenBroadcastReceived 'init piano roll'
xScale = 10
self_createCostume 615 420
setShared 'track color' (list)
for i (trackCount (shared 'score')) {
  local 'c' (colorHSV (-35 + (67 * i)) 0.75 0.7)
  add (shared 'track color') c
}
m_550868133176242 this
m_550170225827469 this
}

script 'PianoRoll' 378 50 {
whenBroadcastReceived 'start piano roll'
m_550868133176242 this
animate {
  m_550170225827469 this
}
}

script 'PianoRoll' 53 385 {
method m_550170225827469 PianoRoll {}
}

script 'PianoRoll' 624 326 {
method m_550171111643680 PianoRoll {}
}

script 'PianoRoll' 621 194 {
whenKeyPressed 'down arrow'
setMy 'xScale' ((my 'xScale') * 1.5)
m_550170225827469 this
}

