␀␀␀␀␀O_K—Çg¸–␀␀–␀␀H␀␀␀modules/b3d4a0286ffea59274a9bc4a0e537fa5690c145b822ec10ecd6adb90c38e8922module

to newGrapher c {
  local 'result' (self_instantiate 'Grapher')
  setGraphColor result c
  return result
}

defineClass Grapher morph 'pen x' 'pen y' color

method initialize Grapher data {
  self_createCostume 300 102 (colorSwatch 230 230 230 255)
  setMy 'pen x' 0
  setMy 'pen y' 0
  setMy 'color' (colorFromSwatch (colorSwatch 72 64 191 255))
}

method plotValue Grapher v {
  self_drawLine (my 'pen x') (my 'pen y') ((my 'pen x') + 1) (100 - v) (my 'color') 2
  increaseMy 'pen x' 1
  if ((my 'pen x') > (self_getWidth)) {
    setMy 'pen x' 0
    self_fillWithColor (colorSwatch 230 230 230 255)
  }
  setMy 'pen y' (100 - v)
}

method setGraphColor Grapher c {
  setMy 'color' c
}
script 'Grapher' 52 354 {
to newGrapher {}
}

script 'Grapher' 377 396 {
method setGraphColor Grapher {}
}

script 'Grapher' 376 204 {
method initialize Grapher {}
}

script 'Grapher' 50 50 {
method plotValue Grapher {}
}

