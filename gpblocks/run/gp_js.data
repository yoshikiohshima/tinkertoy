␀␀␀␀␀ nsK“z¼¡Î␀␀Î␀␀H␀␀␀modules/f61da0e4320a1b5dc4e37a5a26006a56056a0df8a714e00d7f2d5fb0b168ac30module

defineClass Ball morph 'x speed' 'y speed' 'starting x speed' 'starting y speed'


defineClass Pig morph

script 'Ball' 52 241 {
whenKeyPressed 'space'
setMy 'x speed' (my 'starting x speed')
setMy 'y speed' (my 'starting y speed')
self_penUp
self_setPosition -380 -225
self_setPenSize 3
self_penDown
animate {
  increaseMy 'y speed' -1
  self_moveBy (my 'x speed') (my 'y speed')
  if ((self_getY) < -230) {
    stopTask
  }
}
}

script 'Ball' 404 354 {
whenKeyPressed 'down arrow'
increaseMy 'starting y speed' -1
}

script 'Ball' 404 280 {
whenKeyPressed 'up arrow'
increaseMy 'starting y speed' 1
}

script 'Ball' 404 206 {
whenKeyPressed 'left arrow'
increaseMy 'starting x speed' -1
}

script 'Ball' 404 132 {
whenKeyPressed 'right arrow'
increaseMy 'starting x speed' 1
}

script 'Ball' 404 57 {
whenKeyPressed 'c'
self_clear
}

script 'Ball' 52 50 {
whenBroadcastReceived 'go'
self_createCostume 20 20 (transparent)
self_fillCircle 10 10 10 (colorSwatch 79 214 47 255)
setMy 'starting x speed' 10
setMy 'starting y speed' 30
self_setPosition -380 -225
self_clear
}

script 'Pig' 50 53 {
whenBroadcastReceived 'go'
self_setCostume 'Pig'
self_setScale 0.25
if ((rand 10) < 5) {
  self_setPosition (rand -150 360) -215
} else {
  self_setPosition 360 (rand -210 150)
}
}

script 'Pig' 359 53 {
whenBroadcastReceived 'go'
animate {
  self_setRotation (15 * (sin ((msecsSinceStart) / 4)))
  if (self_touching 'Ball') {
    self_setCostume 'Pig-hit'
    self_stopAll
  }
}
}

