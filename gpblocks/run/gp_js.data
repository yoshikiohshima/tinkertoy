defineClass Eye morph

script 'Eye' 50 50 {
whenBroadcastReceived 'go'
self_createCostume 100 100
self_fillWithColor (transparent)
self_fillCircle 50 50 50 (colorSwatch 222 222 222 255)
self_fillCircle 70 50 20 (colorSwatch 19 19 19 255)
self_setStageColor (colorSwatch 5 5 5 255)
animate {
  self_setRotation (self_directionToMouse)
}
}

