␀␀␀␀␀cJéÞiü␀␀ü␀␀H␀␀␀modules/11adfe85c31d0e90d9b3210018dacf129b128f968001332e93c7def2bb717704module

defineClass MyClass morph 'fft mode' 'sound data'

method initialize MyClass args {
  setMy 'fft mode' (booleanConstant false)
  self_setPosition 0 0
  self_createCostume 750 450 (colorSwatch 211 211 211 255)
}

method m_523462863914967 MyClass {
  local 'x' 0
  for sample (my 'sound data') {
    local 'scaled' (sample / 50)
    if (scaled < 0) {
      self_fillRect x 225 1 (abs scaled) (colorSwatch 35 190 30 255)
    } else {
      self_fillRect x (226 - scaled) 1 scaled (colorSwatch 35 190 30 255)
    }
    x += 1
  }
}

method m_523462915575030 MyClass {
  local 'x' 100
  for n (fftOfSamples (my 'sound data')) {
    self_fillRect x (425 - n) 1 n (colorSwatch 35 190 30 255)
    x += 1
  }
}
script 'MyClass' 323 50 {
whenKeyPressed 'space'
setMy 'fft mode' (not (my 'fft mode'))
}

script 'MyClass' 323 185 {
method m_523462863914967 MyClass {}
}

script 'MyClass' 612 151 {
method m_523462915575030 MyClass {}
}

script 'MyClass' 50 333 {
method initialize MyClass {}
}

script 'MyClass' 54 55 {
whenBroadcastReceived 'go'
setMy 'fft mode' (booleanConstant false)
animate {
  setMy 'sound data' (soundInput)
  self_fillWithColor (colorSwatch 217 217 217 255)
  if (my 'fft mode') {
    m_523462915575030 this
  } else {
    m_523462863914967 this
  }
}
}

