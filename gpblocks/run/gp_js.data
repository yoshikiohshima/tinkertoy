␀␀␀␀␀W␀lKïYà	␀␀	␀␀H␀␀␀modules/85991becb55d12244ebcb0399508f06f7ece9c485d07afa6c8d162df07685efdmodule
moduleVariables Grass Rabbits

defineClass Setup morph grassGrowthRate

method m_541513152284037 Setup {
  setMy 'grassGrowthRate' 50
  if ((rand 100) <= (my 'grassGrowthRate')) {
    self_instantiate 'Grass'
  }
}

method m_541513193325638 Setup {
  setShared 'Grass' (count (self_neighbors 10000 'Grass'))
  setShared 'Rabbits' (count (self_neighbors 10000 'Rabbit'))
}

defineClass Rabbit morph direction health

method initialize Rabbit args {
  self_setCostume 'rabbit'
  self_setScale 0.1
}

method m_541453459422513 Rabbit {
  increaseMy 'health' -1
  increaseMy 'direction' (rand -30 30)
  self_moveInDirection (rand 5) (my 'direction')
  self_keepInOwner
}

method m_541453476256810 Rabbit {
  for grass (self_neighbors 0 'Grass') {
    increaseMy 'health' 20
    self_delete grass
  }
}

method m_541453482742058 Rabbit {
  if ((my 'health') > 1000) {
    local 'baby' (self_instantiate 'Rabbit' 0)
    send 'rabbit go' baby
    increaseMy 'health' -500
    playSound 'Pop'
  }
}

method m_541453487958667 Rabbit {
  if ((my 'health') < 0) {
    self_setCostume 'dead rabbit'
    playSound 'Rattle'
    waitSecs 0.5
    self_delete
    stopTask
  }
}

defineClass Grass morph

method initialize Grass args {
  self_setCostume 'grass'
  self_setScale 0.3
  self_setPosition (rand -400 400) (rand -250 250)
}
script 'Setup' 273 50 {
broadcast 'cleanup'
}

script 'Setup' 54 52 {
whenBroadcastReceived 'go'
broadcastAndWait 'cleanup'
self_instantiate 'Rabbit'
broadcast 'rabbit go'
animate {
  m_541513152284037 this
  m_541513193325638 this
}
}

script 'Setup' 275 114 {
method m_541513193325638 Setup {}
}

script 'Setup' 57 288 {
method m_541513152284037 Setup {}
}

script 'Rabbit' 331 596 {
method m_541453476256810 Rabbit {}
}

script 'Rabbit' 59 526 {
method m_541453487958667 Rabbit {}
}

script 'Rabbit' 439 344 {
method m_541453482742058 Rabbit {}
}

script 'Rabbit' 246 209 {
method initialize Rabbit {}
}

script 'Rabbit' 384 50 {
whenBroadcastReceived 'cleanup'
self_delete
}

script 'Rabbit' 56 347 {
method m_541453459422513 Rabbit {}
}

script 'Rabbit' 54 56 {
whenBroadcastReceived 'rabbit go'
setMy 'health' 500
setMy 'direction' (rand 360)
self_setPosition (rand -400 400) (rand -250 250)
animate {
  m_541453459422513 this
  m_541453476256810 this
  m_541453482742058 this
  m_541453487958667 this
}
}

script 'Grass' 50 59 {
method initialize Grass {}
}

script 'Grass' 270 50 {
whenBroadcastReceived 'cleanup'
self_delete
}

