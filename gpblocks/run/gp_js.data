␀␀␀␀␀écWKHÁˆÜ␀␀Ü␀␀H␀␀␀modules/07c8782a0ddcef76c05736c523bbe7da286a0cae7896f09453c87d4178f9f0f8module

to newRect w h c {
  local 'newRect' (self_instantiate 'Rectangle')
  if (notNil w) {
    'set width' newRect w
  }
  if (notNil h) {
    'set height' newRect h
  }
  if (notNil c) {
    'set color' newRect c
  }
  return newRect
}

defineClass Rectangle morph width height color

method draw Rectangle {
  local 'left' ((self_getX) - ((self_getWidth) / 2))
  local 'bottom' ((self_getY) - ((self_getHeight) / 2))
  self_createCostume (my 'width') (my 'height') (my 'color')
  self_setPosition (left + ((self_getWidth) / 2)) (bottom + ((self_getHeight) / 2))
}

method initialize Rectangle data {
  setMy 'width' 300
  setMy 'height' 200
  setMy 'color' (randomColor)
  draw this
}

method 'set color' Rectangle c {
  setMy 'color' c
  draw this
}

method 'set height' Rectangle h {
  setMy 'height' h
  draw this
}

method 'set width' Rectangle w {
  setMy 'width' w
  draw this
}
script 'Rectangle' 427 50 {
method 'set height' Rectangle {}
}

script 'Rectangle' 55 55 {
method 'set width' Rectangle {}
}

script 'Rectangle' 428 189 {
method draw Rectangle {}
}

script 'Rectangle' 429 466 {
method initialize Rectangle {}
}

script 'Rectangle' 55 346 {
to newRect {}
}

script 'Rectangle' 54 195 {
method 'set color' Rectangle {}
}

